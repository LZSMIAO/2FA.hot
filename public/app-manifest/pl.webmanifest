      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/app-screenshots/wide-en.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Wiele kodów"
    },
    {
      "src": "/app-screenshots/narrow-en.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
