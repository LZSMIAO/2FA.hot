{
  "id": "/",
  "name": "2fa.hot",
  "short_name": "2fa.hot",
  "description": "Multifunctionele TOTP-codegenerator",
  "lang": "nl",
  "dir": "ltr",
  "start_url": "/nl",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1e1e1f",
  "theme_color": "#1e1e1f",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/app-screenshots/wide-en.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Multifunctionele TOTP-codegenerator"
    },
    {
      "src": "/app-screenshots/narrow-en.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Multifunctionele TOTP-codegenerator"
    }
  ],
  "shortcuts": [
    {
      "name": "Eén code",
      "url": "/nl?shortcut=single"
    },
    {
      "name": "Meerdere codes",
      "url": "/nl?shortcut=batch"
    },
    {
      "name": "Lokale geschiedenis",
      "url": "/nl/history"
    }
  ]
}
