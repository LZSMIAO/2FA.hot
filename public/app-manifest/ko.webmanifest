  "short_name": "2fa.hot",
  "description": "다기능 TOTP 인증 코드 생성기",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "/ko",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1e1e1f",
  "theme_color": "#1e1e1f",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/app-screenshots/wide-en.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "일괄 코드 생성"
    },
    {
      "src": "/app-screenshots/narrow-en.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "단일 코드 생성"
    }
  ],
  "shortcuts": [
    {
      "name": "단일 코드 생성",
      "url": "/ko?shortcut=single"
    },
    {
      "name": "일괄 코드 생성",
      "url": "/ko?shortcut=batch"
    },
    {
      "name": "로컬 기록",
      "url": "/ko/history"
    }
  ]
