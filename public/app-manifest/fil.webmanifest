{
  "id": "/",
  "name": "2fa.hot",
  "short_name": "2fa.hot",
  "description": "Multifunctional na TOTP Code Generator",
  "lang": "fil",
  "dir": "ltr",
  "start_url": "/fil",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1e1e1f",
  "theme_color": "#1e1e1f",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/app-screenshots/wide-en.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Maramihang code"
    },
    {
      "src": "/app-screenshots/narrow-en.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Isang code"
    }
  ],
  "shortcuts": [
    {
      "name": "Isang code",
      "url": "/fil?shortcut=single"
    },
    {
      "name": "Maramihang code",
      "url": "/fil?shortcut=batch"
    },
    {
      "name": "Lokal na kasaysayan",
      "url": "/fil/history"
    }
  ]
}
