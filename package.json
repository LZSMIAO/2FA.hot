{
  "name": "2fa-hot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "nuxt dev --host localhost",
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset cloudflare-module && node --experimental-strip-types scripts/check-prerender.ts",
    "deploy:check": "pnpm build:cloudflare && wrangler deploy --dry-run",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "preview": "nuxt preview --host localhost",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@iconify-json/lucide": "1.2.130",
    "@nuxt/ui": "4.11.1",
    "@nuxtjs/i18n": "10.6.0",
    "jsqr": "1.4.0",
    "motion-v": "^2.4.2",
    "nuxt": "4.5.2",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "wrangler": "4.129.1"
  },
  "description": "Minecraft-inspired 2FA / TOTP tool with local code generation, batch processing, QR import and fragment links",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LZSMIAO/2FA.hot.git"
  },
  "homepage": "https://2fa.hot",
  "engines": {
    "node": ">=22.18.0"
  }
}
